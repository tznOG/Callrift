<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Callrift" Width="1060" Height="790" MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101116"/><SolidColorBrush x:Key="Sidebar" Color="#14151C"/>
    <SolidColorBrush x:Key="Card" Color="#191B24"/><SolidColorBrush x:Key="Input" Color="#12141C"/>
    <SolidColorBrush x:Key="Fg" Color="#F3F1FC"/><SolidColorBrush x:Key="Muted" Color="#9496A9"/>
    <SolidColorBrush x:Key="Line" Color="#2A2C3A"/><SolidColorBrush x:Key="Accent" Color="#9566FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#29213F"/><SolidColorBrush x:Key="Green" Color="#64D8AD"/>
    <SolidColorBrush x:Key="Red" Color="#FF8B9B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#8152EB"/><Setter Property="BorderBrush" Value="#9A70F5"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#171821"/><Setter Property="Background" Value="#EEEEF5"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="CardBox" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="20"/></Style>
    <DataTemplate x:Key="GameTemplate">
      <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" Background="{DynamicResource AccentSoft}" CornerRadius="7" VerticalAlignment="Top" ClipToBounds="True"><Grid><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Column="1" Margin="6,0,12,0"><TextBlock Foreground="{DynamicResource Fg}" Text="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/><TextBlock Text="{Binding id, StringFormat=ID: {0}}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0"/><StackPanel x:Name="Timing" Visibility="Collapsed" Margin="0,5,0,0"><TextBlock Text="{Binding Elapsed, StringFormat={}{0} / 00:15:00}" FontSize="10" Foreground="{DynamicResource Green}"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Foreground="{DynamicResource Green}" Background="{DynamicResource Line}" Margin="0,4,0,0"/></StackPanel></StackPanel>
        <Button Grid.Column="2" Content="{Binding Star}" Tag="favorite" FontSize="21" Foreground="#D6B55D" Background="Transparent" BorderThickness="0" Padding="5" ToolTip="Favorito"/>
        <ComboBox x:Name="ExeChoice" Grid.Column="3" ItemsSource="{Binding WindowsExecutables}" SelectedIndex="0" FontSize="11" Margin="4,0,10,0" VerticalAlignment="Center" MaxDropDownHeight="220" ToolTip="{Binding Details}"/>
        <Button Grid.Column="4" Content="{Binding ActionLabel}" Tag="run" Padding="10,8" Style="{StaticResource Primary}" IsEnabled="{Binding CanRun}" VerticalAlignment="Center"/>
      </Grid>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Running}" Value="True"><Setter TargetName="Timing" Property="Visibility" Value="Visible"/><Setter TargetName="ExeChoice" Property="IsEnabled" Value="False"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="{DynamicResource Sidebar}"><TextBlock Text="CALLRIFT" Margin="20,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Padding="16,10" BorderThickness="0" Background="Transparent" ToolTip="Minimizar"/><Button x:Name="Maximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Padding="16,10" BorderThickness="0" Background="Transparent" ToolTip="Maximizar"/><Button x:Name="Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Padding="16,10" BorderThickness="0" Background="Transparent" ToolTip="Fechar"/></StackPanel></Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,23,14,14"><DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="4,0,0,25"><Image x:Name="BrandMark" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Callrift" FontWeight="Bold" FontSize="20" Margin="0,12,0,4"/><TextBlock Tag="t:BrandDescription" Text="VPN para Discord" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/><TextBlock Text="SUA CALL. OUTRA ROTA." Foreground="{DynamicResource Muted}" FontSize="8" FontWeight="SemiBold"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="4,16,0,0"><Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Tag="t:Native" Text="Nativo e leve" FontSize="11" Margin="8,0,0,0"/></StackPanel></Border><TextBlock Text="v1.3.0  ·  Windows x64" Style="{StaticResource MutedText}" FontSize="10" Margin="0,12,0,0"/></StackPanel>
          <StackPanel><TextBlock Text="WORKSPACE" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,10"/><Button x:Name="NavVpn" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Tag="t:Connection" Text="Conexão"/></StackPanel></Button><Button x:Name="NavActivity" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Presence"/></StackPanel></Button><Button x:Name="NavLogs" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Tag="t:Logs" Text="Atividade"/></StackPanel></Button><Button x:Name="NavSettings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Tag="t:Settings" Text="Configurações"/></StackPanel></Button></StackPanel>
        </DockPanel></Border>
        <Grid Grid.Column="1" Margin="30,22,30,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="12" Margin="0,0,0,16"><DockPanel><Button x:Name="DownloadUpdate" DockPanel.Dock="Right" Tag="t:GetUpdate" Content="Baixar atualização" Padding="10,7" Margin="12,0,0,0" Style="{StaticResource Primary}"/><StackPanel><TextBlock x:Name="UpdateHeadline" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Tag="t:UpdateHint" Text="Uma nova versão do Callrift está disponível." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
          <ScrollViewer x:Name="VpnPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="VpnLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,22"><TextBlock Tag="t:Connection" Text="CONEXÃO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Tag="t:VpnTitle" Text="Seu Discord, conectado." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Tag="t:VpnSubtitle" Text="Uma rota para sua call. A conexão de sempre para seus jogos." Style="{StaticResource MutedText}"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBox}" Margin="0,0,0,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock x:Name="StatusIcon" Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="StatusTitle" Text="Pronto para conectar" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StatusSubtitle" Text="Importe um perfil da Proton VPN para começar." Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="9,5" VerticalAlignment="Top" Margin="10,0,0,0"><TextBlock Text="WIREGUARD" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold"/></Border></Grid>
              <Grid Grid.Row="1" Margin="0,20,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Tag="t:Route" Text="ROTEAMENTO" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Tag="t:DiscordOnly" Text="Somente Discord" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Tag="t:OtherApps" Text="OUTROS APLICATIVOS" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Tag="t:Direct" Text="Conexão direta" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DISCORD" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="DiscordStatus" Text="Verificando..." FontSize="12" Margin="0,5,0,0"/></StackPanel></Grid>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Button x:Name="Connect" Style="{StaticResource Primary}" Content="Conectar VPN" Padding="14,12"/><Button x:Name="OpenDiscord" Grid.Column="2" Tag="t:OpenDiscord" Content="Abrir Discord"/></Grid>
            </Grid></Border>
            <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,10"><TextBlock Tag="t:YourProfiles" Text="Seus perfis" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom"/><Button x:Name="GenerateProfile" HorizontalAlignment="Right" Content="Gerar .conf na Proton VPN  ↗" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" Padding="0,5" FontSize="11"/></Grid>
              <Grid Grid.Row="1" Margin="12,0,12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Tag="t:Profile" Text="PERFIL" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Grid.Column="1" Text="ENDPOINT" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Grid.Column="2" Tag="t:TestMetric" Text="TEMPO HTTPS" Foreground="{DynamicResource Muted}" FontSize="10"/></Grid>
              <Grid Grid.Row="2" MinHeight="65" MaxHeight="180"><ListBox x:Name="Profiles"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,10" ToolTip="{Binding TestTooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Modified}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding LatencyLabel}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TestLabel}" Foreground="{DynamicResource Green}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Border x:Name="EmptyProfiles" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Top"><StackPanel><TextBlock Tag="t:NoProfiles" Text="Seu primeiro perfil começa aqui." HorizontalAlignment="Center" Margin="0,5,0,6" Foreground="{DynamicResource Muted}"/><TextBlock Tag="t:ImportHint" Text="Gere um arquivo WireGuard na Proton e importe abaixo." HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></Border></Grid>
              <StackPanel Grid.Row="3" Margin="0,8,0,12"><WrapPanel><Button x:Name="ImportProfile" Tag="t:ImportConf" Content="＋  Importar .conf" Padding="12,8" Margin="0,0,8,6"/><Button x:Name="RemoveProfile" Tag="t:Remove" Content="Remover" Padding="12,8" Margin="0,0,8,6"/><Button x:Name="FolderProfiles" Tag="t:Folder" Content="Abrir pasta" Background="Transparent" BorderThickness="0" Padding="10,8" Margin="0,0,8,6"/><Button x:Name="TestProfiles" Tag="t:TestProfiles" Content="Testar perfis" Padding="12,8" Margin="0,0,8,6"/><Button x:Name="CancelTests" Tag="t:CancelTest" Content="Cancelar teste" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="ProfileTestInfo" Tag="t:TestHint" Text="Compare os perfis por HTTPS dentro de cada túnel, com a VPN desconectada." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16"/><Border x:Name="RestartBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="10" Margin="0,8,0,0"><DockPanel><Button x:Name="RestartDiscord" DockPanel.Dock="Right" Tag="t:RestartDiscord" Content="Reiniciar Discord" Padding="9,6" Margin="10,0,0,0"/><TextBlock Tag="t:RestartHint" Text="Reinicie o Discord para renovar as conexões existentes." Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border></StackPanel>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource CardBox}" Padding="15,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="QuickStartup" Tag="t:StartWindows" Content="Iniciar com o Windows" Margin="0,0,0,4"/><TextBlock Tag="t:StartupHint" Text="Use o último perfil automaticamente ao entrar no Windows." Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="15,0,5,0" VerticalAlignment="Center"/></Grid></Border>
          </Grid></ScrollViewer>
          <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="PRESENCE" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Tag="t:ActivityTitle" Text="Sua atividade. Sua presença." FontSize="25" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Tag="t:ActivitySubtitle" Text="Presence: seu catálogo e suas atividades, em um módulo próprio do app." Style="{StaticResource MutedText}"/></StackPanel>
            <StackPanel Grid.Row="1"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="Nome, ID ou apelido. Separe buscas por vírgulas."/><Button x:Name="RefreshGames" Grid.Column="1" Tag="t:Refresh" Content="Atualizar" Margin="10,0,0,0"/></Grid><Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button x:Name="FilterAll" Tag="t:AllGames" Content="Todos" Padding="12,6"/><Button x:Name="FilterFavorites" Tag="t:Favorites" Content="★  Favoritos" Margin="7,0,0,0" Padding="12,6"/><Button x:Name="FilterRunning" Tag="t:Running" Content="Em execução" Margin="7,0,0,0" Padding="12,6"/></StackPanel><Button x:Name="StopAll" Tag="t:StopAll" Content="Parar todos" Padding="12,6" HorizontalAlignment="Right" Foreground="{DynamicResource Red}"/></Grid><TextBlock x:Name="GameSummary" Text="Carregue o catálogo para começar." Style="{StaticResource MutedText}" Margin="0,0,0,10"/></StackPanel>
            <Grid Grid.Row="2"><ListBox x:Name="Games" ItemTemplate="{StaticResource GameTemplate}"/><TextBlock x:Name="GameEmpty" Text="Carregando catálogo do Discord..." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/></Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CacheInfo" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Tag="t:DetectionHint" Text="Ative a detecção de jogos nas configurações do Discord." Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PrevPage" Content="‹" Padding="12,5"/><TextBlock x:Name="PageLabel" Text="1 / 1" VerticalAlignment="Center" Margin="12,0" FontSize="11"/><Button x:Name="NextPage" Content="›" Padding="12,5"/></StackPanel></Grid>
          </Grid>
          <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,22"><TextBlock Tag="t:Logs" Text="ATIVIDADE" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock Tag="t:LogsTitle" Text="Tudo no seu controle." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Tag="t:LogsSubtitle" Text="Eventos locais da conexão e das atividades. Sem registrar chaves." Style="{StaticResource MutedText}"/></StackPanel><TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="CopyLogs" Tag="t:CopyLogs" Content="Copiar registro"/><Button x:Name="ClearLogs" Tag="t:Clear" Content="Limpar" Margin="8,0,0,0"/></StackPanel></Grid>
          <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Tag="t:Settings" Text="CONFIGURAÇÕES" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock Tag="t:SettingsTitle" Text="Do seu jeito." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,22"/>
            <Border Style="{StaticResource CardBox}" Margin="0,0,0,14"><StackPanel><TextBlock Tag="t:Startup" Text="Inicialização e bandeja" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/><CheckBox x:Name="StartWindows" Tag="t:StartWindows" Content="Iniciar com o Windows"/><CheckBox x:Name="AutoConnect" Tag="t:AutoConnect" Content="Conectar o último perfil ao abrir o app"/><CheckBox x:Name="AutoDiscord" Tag="t:AutoDiscord" Content="Abrir Discord depois de verificar a VPN"/><CheckBox x:Name="TrayOption" Tag="t:TrayOption" Content="Continuar na bandeja ao fechar a janela"/><TextBlock Tag="t:ElevationHint" Text="O Windows pede permissão ao conectar. A inicialização usa uma tarefa autorizada por você." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBox}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Tag="t:Appearance" Text="Aparência e idioma" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="LightTheme" Tag="t:LightTheme" Content="Usar tema claro" Margin="0,12,0,0"/></StackPanel><ComboBox x:Name="Language" Grid.Column="1" VerticalAlignment="Center"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="Español" Tag="es-ES"/></ComboBox></Grid></Border>
            <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Tag="t:About" Text="Sobre este app" FontSize="16" FontWeight="SemiBold"/><TextBlock Tag="t:AboutText" Text="Callrift 1.3 · VPN para Discord · Presence · Interface nativa WPF · WireGuard / sing-box 1.14.4." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,8"/><TextBlock Tag="t:RouteDetail" Text="Apenas Discord está na saída VPN. O adaptador virtual também classifica o tráfego dos outros apps, encaminhado diretamente. O DNS do Windows é preservado. Esta versão não tem kill switch." Style="{StaticResource MutedText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ShowLicenses" Tag="t:Licenses" Content="Licenças e créditos" Padding="12,8"/></StackPanel></StackPanel></Border>
